# Google Gemini — visual guidance
GEMINI_API_KEY=YOUR_GEMINI_KEY
GEMINI_MODEL=gemini-2.5-flash

# OpenAI — optional premium vision review / Discord bridge
OPENAI_API_KEY=YOUR_OPENAI_KEY
OPENAI_MODEL=gpt-5.6-luna
ENABLE_OPENAI_REVIEW=0

# Hugging Face Inference Providers — Qwen Vision + final review
HF_TOKEN=YOUR_HF_TOKEN
HF_MODEL=Qwen/Qwen2.5-VL-32B-Instruct:fastest

# Discord bot
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN

# HTTP API
OUTPUT_DIR=./api_outputs
MAX_IMAGE_BYTES=12582912
