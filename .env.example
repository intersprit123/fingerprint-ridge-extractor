# ============================================================
# Fingerprint Ridge Extractor — environment configuration
# ============================================================
# IMPORTANT:
# Copy this file to .env locally and put your real secrets there.
# NEVER commit .env or paste real API keys into GitHub.

# ------------------------------------------------------------
# Google Gemini Vision — realistic visual guidance
# ------------------------------------------------------------
# Get your key from Google AI Studio.
GEMINI_API_KEY=YOUR_GEMINI_KEY
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------
# Hugging Face — optional Qwen prediction/review branch
# ------------------------------------------------------------
# Leave blank if you do not want the prediction/review branch.
HF_TOKEN=YOUR_HF_TOKEN
HF_MODEL=Qwen/Qwen2.5-VL-32B-Instruct:fastest

# ------------------------------------------------------------
# Discord bot — optional
# ------------------------------------------------------------
# Only needed if you create/use your own Discord application/bot.
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN

# ------------------------------------------------------------
# Local HTTP API
# ------------------------------------------------------------
OUTPUT_DIR=./api_outputs
MAX_IMAGE_BYTES=12582912
