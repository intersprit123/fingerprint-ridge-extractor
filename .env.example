# Google Gemini — visual guidance for the realistic branch
GEMINI_API_KEY=YOUR_GEMINI_KEY
GEMINI_MODEL=gemini-2.5-flash

# Hugging Face Inference Providers — optional Qwen prediction/review branch
HF_TOKEN=YOUR_HF_TOKEN
HF_MODEL=Qwen/Qwen2.5-VL-32B-Instruct:fastest

# Discord bot — only if you have an existing Discord application/bot
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN

# HTTP API
OUTPUT_DIR=./api_outputs
MAX_IMAGE_BYTES=12582912
